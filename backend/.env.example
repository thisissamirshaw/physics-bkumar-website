# Copy to backend/.env and fill in. Never commit the real .env.

# "production" refuses to start while SECRET_KEY is the default.
APP_ENV=development

# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The super admin account is created from these the first time the server starts.
# Left out, it starts as superadmin@example.com / 12345678. After that, change the email and
# password in the console (Account & security); these two lines are only read again by
# `python -m app.reset_admin`, which is how you get back in after a forgotten password.
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=

# SQLite file by default. Postgres works too: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:////data/physics.db

# Only needed if the frontend is served from a different domain than the API
# (for example the GitHub Pages copy talking to a server on Render).
# CORS_ORIGINS=["https://www.example.com"]
