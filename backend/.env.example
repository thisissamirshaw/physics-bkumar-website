# Copy to backend/.env and fill in. Never commit the real .env.

# "production" refuses to start while SECRET_KEY or ADMIN_PASSWORD are defaults.
APP_ENV=development

# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Password for /admin
ADMIN_PASSWORD=

# SQLite file by default. Postgres works too: postgresql+psycopg://user:pass@host/db
# DATABASE_URL=sqlite:////data/physics.db

# Only needed if the frontend is served from a different domain than the API.
# CORS_ORIGINS=["https://www.example.com"]
